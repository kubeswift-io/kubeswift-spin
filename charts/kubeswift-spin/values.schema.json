{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "quantity": {
      "type": [
        "string",
        "integer",
        "number"
      ]
    }
  },
  "properties": {
    "image": {
      "$ref": "#/definitions/image"
    },
    "runtimeImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultCPU": {
          "$ref": "#/definitions/quantity"
        },
        "defaultMemory": {
          "$ref": "#/definitions/quantity"
        },
        "minMemory": {
          "$ref": "#/definitions/quantity"
        },
        "maxMemory": {
          "$ref": "#/definitions/quantity"
        },
        "maxVCPUs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "watchNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "error"
          ]
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "executors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "namespaces"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "namespaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "networkMode": {
            "type": "string",
            "enum": [
              "restricted",
              "open"
            ]
          },
          "rootfsMode": {
            "type": "string",
            "enum": [
              "block",
              "virtiofs"
            ]
          },
          "kernelProfile": {
            "type": "string"
          },
          "sandboxPool": {
            "type": "string"
          },
          "nodeSelector": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "defaultCPU": {
            "$ref": "#/definitions/quantity"
          },
          "defaultMemory": {
            "$ref": "#/definitions/quantity"
          },
          "runtimeImage": {
            "type": "string"
          },
          "runtimeImagePullSecret": {
            "type": "string"
          },
          "runtimeImageVerifyKeySecret": {
            "type": "string"
          },
          "otel": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exporter_otlp_endpoint": {
                "type": "string"
              },
              "exporter_otlp_traces_endpoint": {
                "type": "string"
              },
              "exporter_otlp_metrics_endpoint": {
                "type": "string"
              },
              "exporter_otlp_logs_endpoint": {
                "type": "string"
              }
            }
          },
          "egressAllow": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "namespace": {
                      "type": "string"
                    }
                  }
                },
                "cidr": {
                  "type": "string"
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "port"
                    ],
                    "properties": {
                      "port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "protocol": {
                        "type": "string",
                        "enum": [
                          "TCP",
                          "UDP"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "ingressFrom": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object"
            }
          },
          "readinessStartup": {
            "type": "string",
            "enum": [
              "auto",
              "always",
              "never"
            ],
            "description": "spin.kubeswift.io/readiness-startup: when readiness checks run quickly until they first pass (KubeSwift v0.16.2). auto (default) only for the check kubeswift-spin adds; always also for SpinApp checks; never for none."
          },
          "drainPeriod": {
            "type": "string",
            "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m))+$",
            "description": "spin.kubeswift.io/drain-period: how long a deleted replica keeps running after its readiness was withdrawn, before KubeSwift stops it (spec.termination.drainPeriod, KubeSwift v0.16.3), 0s to 10m (checked by the controller). The default for the executor's SpinApps; a SpinApp's own annotation overrides it. Unset keeps KubeSwift's default of 5s. Setting or changing it replaces the affected replicas once."
          },
          "maxDrainPeriod": {
            "type": "string",
            "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m))+$",
            "description": "spin.kubeswift.io/max-drain-period: the longest drain period the executor's SpinApps may set, 0s to 10m (checked by the controller). Unset allows KubeSwift's 10m."
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer"
        },
        "secure": {
          "type": "boolean"
        },
        "service": {
          "type": "object"
        },
        "serviceMonitor": {
          "type": "object"
        }
      }
    },
    "compiledCache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "repository": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+$"
        },
        "architecture": {
          "type": "string",
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "retention": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "pullSecretName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "fetchTimeout": {
          "type": "string",
          "description": "0s to 5m: KubeSwift's limit for an optional artifact.",
          "pattern": "^([0-9]{1,5}ms|[0-9]{1,2}(\\.[0-9]+)?s|[12][0-9]{2}(\\.[0-9]+)?s|300s|[0-4]m([0-9]{1,2}s)?|5m)$"
        },
        "manager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "replicaCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "logLevel": {
              "type": "string",
              "enum": [
                "debug",
                "info",
                "error"
              ]
            },
            "extraArgs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "extraRuntimes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$"
          }
        },
        "maxRecordsPerNamespace": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "compiler": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(s|m|h))+$"
            },
            "maxSize": {
              "$ref": "#/definitions/quantity"
            },
            "maxEntries": {
              "type": "integer",
              "minimum": 2,
              "maximum": 1048576
            },
            "maxConcurrent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "maxConcurrentPerNamespace": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        },
        "signer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^$|^sha256:[a-f0-9]{64}$"
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "key": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "secretName": {
                  "type": "string"
                },
                "kmsRef": {
                  "type": "string",
                  "pattern": "^$|^(awskms|gcpkms|azurekms|hashivault)://.+$"
                }
              }
            },
            "registryCredentialsSecret": {
              "type": "string"
            },
            "extraEnv": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "serviceAccountAnnotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "logLevel": {
              "type": "string",
              "enum": [
                "debug",
                "info",
                "error"
              ]
            },
            "extraArgs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resources": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
