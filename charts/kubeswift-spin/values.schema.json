{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "quantity": {"type": ["string", "integer", "number"]}
  },
  "properties": {
    "image": {"$ref": "#/definitions/image"},
    "runtimeImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "replicaCount": {"type": "integer", "minimum": 1},
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultCPU": {"$ref": "#/definitions/quantity"},
        "defaultMemory": {"$ref": "#/definitions/quantity"},
        "minMemory": {"$ref": "#/definitions/quantity"},
        "maxMemory": {"$ref": "#/definitions/quantity"},
        "maxVCPUs": {"type": "integer", "minimum": 1, "maximum": 256},
        "maxReplicas": {"type": "integer", "minimum": 1, "maximum": 1000},
        "watchNamespaces": {"type": "array", "items": {"type": "string"}},
        "logLevel": {"type": "string", "enum": ["debug", "info", "error"]},
        "extraArgs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "executors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "namespaces"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "namespaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "networkMode": {"type": "string", "enum": ["restricted", "open"]},
          "rootfsMode": {"type": "string", "enum": ["block", "virtiofs"]},
          "kernelProfile": {"type": "string"},
          "sandboxPool": {"type": "string"},
          "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
          "defaultCPU": {"$ref": "#/definitions/quantity"},
          "defaultMemory": {"$ref": "#/definitions/quantity"},
          "runtimeImage": {"type": "string"},
          "runtimeImagePullSecret": {"type": "string"},
          "runtimeImageVerifyKeySecret": {"type": "string"},
          "otel": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exporter_otlp_endpoint": {"type": "string"},
              "exporter_otlp_traces_endpoint": {"type": "string"},
              "exporter_otlp_metrics_endpoint": {"type": "string"},
              "exporter_otlp_logs_endpoint": {"type": "string"}
            }
          }
        }
      }
    },
    "serviceAccount": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "resources": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "priorityClassName": {"type": "string"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer"},
        "secure": {"type": "boolean"},
        "service": {"type": "object"},
        "serviceMonitor": {"type": "object"}
      }
    }
  }
}
